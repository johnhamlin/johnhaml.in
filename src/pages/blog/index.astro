---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/astro/PostList.astro';
import LoopVideo from '../../components/astro/LoopVideo.astro';
import { BLOG_DESCRIPTION, getVisiblePosts } from '../../lib/blog';

const posts = await getVisiblePosts();
---

<BlogLayout title="Blog | John Hamlin" description={BLOG_DESCRIPTION}>
  <header class="mb-12 text-center">
    <h1 class="text-4xl font-medium sm:text-5xl">Blog</h1>
    <p class="mx-auto mt-4 max-w-xl text-xl font-medium leading-[1.5] text-gray-700 dark:text-gray-300 sm:text-2xl">
      {BLOG_DESCRIPTION}
    </p>
    <p class="mt-3">
      <a
        href="/rss.xml"
        class="text-sm text-gray-500 underline decoration-gray-300 underline-offset-2 transition hover:text-gray-950 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-gray-100"
      >
        RSS feed
      </a>
    </p>
    <figure class="mt-8">
      <LoopVideo
        src="/factory-migration.mp4"
        poster="/factory-migration.webp"
        alt="An overnight migration: backup, a permission failure, automatic rollback, a 25-line fix, a rerun, and done by morning."
        eager
      />
      <figcaption class="mt-3 text-sm text-gray-500 dark:text-gray-400">
        Overnight, an agent hit a permission error, rolled back, shipped a 25-line fix, and finished by morning.
      </figcaption>
    </figure>
  </header>

  {
    posts.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-gray-300 px-6 py-16 text-center text-gray-500 dark:border-white/15 dark:text-gray-400">
        No posts yet.
      </p>
    ) : (
      <PostList posts={posts} />
    )
  }
</BlogLayout>
