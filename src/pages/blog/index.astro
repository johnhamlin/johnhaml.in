---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/astro/PostList.astro';
import { BLOG_DESCRIPTION, getVisiblePosts } from '../../lib/blog';

const posts = await getVisiblePosts();
---

<BlogLayout title="Blog | John Hamlin" description={BLOG_DESCRIPTION}>
  <header class="mb-10 text-center">
    <h1 class="text-3xl font-medium">Blog</h1>
    <p class="mx-auto mt-3 max-w-xl text-gray-600 dark:text-gray-300">{BLOG_DESCRIPTION}</p>
    <p class="mt-3">
      <a
        href="/rss.xml"
        class="text-sm text-gray-500 underline decoration-gray-300 underline-offset-2 transition hover:text-gray-950 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-gray-100"
      >
        RSS feed
      </a>
    </p>
  </header>

  {
    posts.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-gray-300 px-6 py-16 text-center text-gray-500 dark:border-white/15 dark:text-gray-400">
        No posts yet.
      </p>
    ) : (
      <PostList posts={posts} />
    )
  }
</BlogLayout>
