---
import SectionHeading from './SectionHeading.astro';
import LoopVideo from './LoopVideo.astro';
import { factoryTiles } from '../../data/factory';
---

<section id="factory" class="mb-28 w-full max-w-[53rem] scroll-mt-28 sm:mb-40">
  <SectionHeading>Software factory</SectionHeading>
  <p class="mx-auto -mt-4 mb-8 max-w-2xl text-center leading-relaxed text-gray-700 dark:text-white/70">
    How I ship now: a few bots write the code, and I review the scary parts.
  </p>
  <ul class="grid gap-4 md:grid-cols-2">
    {
      factoryTiles.map(({ title, body, media, className }) => (
        <li
          class:list={[
            'flex flex-col rounded-xl border border-black/5 bg-white/70 p-6 dark:border-white/10 dark:bg-white/10',
            className,
          ]}
        >
          <h3 class="text-xl font-semibold">{title}</h3>
          <p class="mt-2 leading-relaxed text-gray-700 dark:text-white/70">{body}</p>
          {media && <LoopVideo {...media} class="mt-5" />}
        </li>
      ))
    }
  </ul>
</section>
